# Copia este archivo a .env y rellena los valores. .env está en .gitignore: NUNCA lo subas.

# --- Modo ---------------------------------------------------------------
# backtest | paper | live. Live exige además LIVE_CONFIRM=yes y claves de producción;
# si falta algo, el bot arranca en paper y avisa.
TRADING_MODE=paper
LIVE_CONFIRM=

# --- Binance producción (solo trading spot, SIN retiros, restringida a la IP del servidor) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Binance Spot Testnet (claves separadas) ------------------------------
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- IA (Fase 5) -----------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Telegram (Fase 6) -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Base de datos -----------------------------------------------------------
# docker compose construye DATABASE_URL a partir de POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
# Solo para ejecutar fuera de Docker:
# DATABASE_URL=postgresql://bot:<password>@localhost:5432/trading_bot

# --- Paper trading -------------------------------------------------------------
# false en la máquina donde NO deba correr (una sola fuente de verdad).
PAPER_ENABLED=true
# Intervalos de velas en esta máquina (vacío = settings.yaml). Servidor pequeño: 4h,1d
DATA_INTERVALS=

# --- Informe semanal por correo (domingo 23:30 hora Bogotá) ----------------------
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=

# --- Otros ---------------------------------------------------------------------
# LOG_FORMAT=json   # json | console
